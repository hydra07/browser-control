        "version:bump": "bun run scripts/bump-version.ts"
    },
    "dependencies": {
        "@browsercontrol/shared": "workspace:*",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/chrome": "^0.0.263",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@wxt-dev/module-react": "^1.1.5",
        "devtools-protocol": "^0.0.1672245",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.4.5",
        "wxt": "^0.21.4"
    }
}
