{
    "name": "@browsercontrol/extension",
    "description": "The Chrome extension — service worker, offscreen document, and the side panel. Built with WXT.",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "check": "tsc --noEmit",
        "build": "wxt build",
        "zip": "wxt zip",
