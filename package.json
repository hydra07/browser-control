{
  "name": "browsercontrol",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome extension + local MCP server for driving your everyday Chrome browser via CDP — monorepo root, holds no runtime deps of its own.",
  "workspaces": ["app/extension", "app/server", "packages/*"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check"
  },
  "bin": {
    "browsercontrol": "app/server/src/daemon.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}
