{
    "name": "browsercontrol",
    "version": "0.0.0",
    "private": true,
    "description": "Go CLI + Chrome extension for driving your everyday Chrome via CDP — monorepo root for the extension workspaces.",
    "workspaces": [
        "app/extension",
        "packages/*"
    ],
    "packageManager": "bun@1.3.14",
    "scripts": {
        "build": "turbo run build",
        "build:affected": "turbo run build --affected",
        "check": "turbo run check",
        "check:affected": "turbo run check --affected",
        "check:changed": "biome check --changed",
        "check:staged": "biome check --staged",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "test": "turbo run test",
        "check:all": "turbo run check && biome check ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9",
        "turbo": "^2.10.11"
    }
}
