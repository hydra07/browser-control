{
  "name": "browsercontrol",
  "version": "0.1.0",
  "description": "Chrome extension + local MCP server for driving your everyday Chrome browser via CDP",
  "scripts": {
    "build": "bun run version:sync && tsc && bun run copy:assets && bun run build:sidepanel",
    "copy:assets": "bun -e \"await Bun.write('dist/extension/offscreen.html', await Bun.file('src/extension/offscreen.html').text()); await Bun.write('dist/extension/sidepanel/index.html', await Bun.file('src/extension/sidepanel/index.html').text())\"",
    "build:sidepanel": "bun build src/extension/sidepanel/main.tsx --outdir dist/extension/sidepanel --target browser --minify",
    "check:server": "tsc -p tsconfig.server.json",
    "check:extension": "tsc --noEmit",
    "check:sidepanel": "tsc -p tsconfig.sidepanel.json",
    "version:sync": "bun run scripts/sync-version.ts",
    "version:bump": "bun run scripts/bump-version.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.0.263",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "devtools-protocol": "^0.0.1672245",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
