{
  "manifest_version": 3,
  "name": "BrowserControl Agent",
  "version": "1.12.1",
  "description": "AI Workspace extension for controlling browser via CDP",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {},
  "background": {
    "service_worker": "dist/extension/background.js",
    "type": "module"
  }
}
